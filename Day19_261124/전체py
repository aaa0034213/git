# kakaocoupon.py

# 내가 만든 모듈 가져오기
import my
import sqlite3
import re

my.st.title("쿠폰 보내기")

# 로그인 상태 초기화
if "로그인" not in my.st.session_state:
    my.st.session_state["로그인"] = False

if "아이디" not in my.st.session_state:
    my.st.session_state["아이디"] = None


# ==============================
# 로그인 및 회원가입
# ==============================

if not my.st.session_state["로그인"]:

    my.st.subheader("로그인 실습")

    로그인탭, 가입탭 = my.st.tabs(["로그인", "회원가입"])

    # 로그인탭
    with 로그인탭:

        아이디 = my.st.text_input(
            "아이디", key="로그인_아이디"
        ).strip()

        비밀번호 = my.st.text_input(
            "비밀번호", type="password",
            key="로그인_비번"
        ).strip()

        if my.st.button("로그인"):

            my.마우스.execute("""
                SELECT * FROM members
                WHERE id = ? AND password = ?
            """, (아이디, 비밀번호))

            result = my.마우스.fetchone()

            if result:
                my.st.session_state["로그인"] = True
                my.st.session_state["아이디"] = 아이디
                my.st.rerun()

            else:
                my.st.error("아이디 또는 비밀번호가 틀렸습니다.")


    # 회원가입탭
    with 가입탭:

        id = my.st.text_input(
            "id", key="가입_아이디"
        ).strip()

        password = my.st.text_input(
            "password", type="password",
            key="가입_비번"
        ).strip()

        name = my.st.text_input("name").strip()

        phone_number = my.st.text_input(
            "전화번호 (ex: 010-1234-5678)"
        ).strip()

        if my.st.button("회원가입"):

            try:
                if not all([id, password, name, phone_number]):
                    raise ValueError("모든 항목을 입력해주세요.")

                if len(password) < 8:
                    raise ValueError("비밀번호는 8자 이상입니다.")

                if not re.search(r"[!@#$%^&*]", password):
                    raise ValueError("특수문자를 포함해주세요.")

                if not re.fullmatch(
                    r"010-[0-9]{4}-[0-9]{4}", phone_number
                ):
                    raise ValueError("전화번호 형식이 잘못되었습니다.")

                my.마우스.execute("""
                    INSERT INTO members
                        (id, password, name, phone_number)
                    VALUES
                        (?, ?, ?, ?)
                """, (id, password, name, phone_number))

                my.conn.commit()
                my.st.success("회원가입 성공!")

            except ValueError as e:
                my.st.error(str(e))

            except sqlite3.IntegrityError as e:
                my.conn.rollback()
                my.st.error(f"아이디 중복 또는 제약조건 위반: {e}")

            except Exception as e:
                my.conn.rollback()
                my.st.error(str(e))


# ==============================
# 로그인 성공 후 화면
# ==============================

else:

    sender_id = my.st.session_state["아이디"]

    my.st.success(f"{sender_id}님 환영합니다.")

    if my.st.button("로그아웃"):
        my.st.session_state["로그인"] = False
        my.st.session_state["아이디"] = None
        my.st.rerun()

    친구탭, 보내기탭, 받기탭 = my.st.tabs([
        "친구목록",
        "선물하기",
        "쿠폰 받기"
    ])


    # ==============================
    # 친구목록 조회
    # ==============================

    with 친구탭:

        my.st.subheader("친구목록")

        my.마우스.execute("""
            SELECT id, name
            FROM members
            WHERE id != ?
        """, (sender_id,))

        result = my.마우스.fetchall()

        for 친구 in result:
            my.st.write(친구)


    # ==============================
    # 선물하기
    # ==============================

    with 보내기탭:

        my.st.subheader("선물하기")

        my.st.write("보내는 사람 :", sender_id)

        receiver_id = my.st.text_input(
            "받는 사람 아이디"
        ).strip()

        phone_number = my.st.text_input(
            "받는 사람 전화번호"
        ).strip()

        product_name = my.st.text_input(
            "상품 이름"
        ).strip()

        coupon_number = my.st.text_input(
            "쿠폰번호", key="보내기_쿠폰번호"
        ).strip()

        card_message = my.st.text_area(
            "카드 메시지 (선택사항)"
        ).strip()

        if my.st.button("선물하기"):

            try:
                # 필수 항목 검사
                if not all([
                    sender_id,
                    receiver_id,
                    phone_number,
                    product_name,
                    coupon_number
                ]):
                    raise ValueError("필수 항목을 입력해주세요.")

                # 전화번호 형식 검사
                if not re.fullmatch(
                    r"010-[0-9]{4}-[0-9]{4}", phone_number
                ):
                    raise ValueError("전화번호 형식이 잘못되었습니다.")

                # 받는 사람 존재 여부 확인
                my.마우스.execute("""
                    SELECT id FROM members
                    WHERE id = ? AND phone_number = ?
                """, (receiver_id, phone_number))

                if not my.마우스.fetchone():
                    raise ValueError("받는 사람의 정보가 일치하지 않습니다.")

                # 쿠폰 저장
                my.마우스.execute("""
                    INSERT INTO coupons (
                        sender_id,
                        receiver_id,
                        phone_number,
                        product_name,
                        coupon_number,
                        card_message
                    )
                    VALUES (?, ?, ?, ?, ?, ?)
                """, (
                    sender_id,
                    receiver_id,
                    phone_number,
                    product_name,
                    coupon_number,
                    card_message
                ))

                선물번호 = my.마우스.lastrowid

                my.conn.commit()

                my.st.success("선물하기 성공!")
                my.st.write("선물번호 :", 선물번호)
                my.st.write("쿠폰번호 :", coupon_number)

            except ValueError as e:
                my.st.error(str(e))

            except sqlite3.IntegrityError as e:
                my.conn.rollback()
                my.st.error(f"쿠폰번호 중복 또는 제약조건 위반: {e}")

            except Exception as e:
                my.conn.rollback()
                my.st.error(str(e))


    # ==============================
    # 쿠폰 받기
    # ==============================

    with 받기탭:

        my.st.subheader("쿠폰 받기")

        coupon_number = my.st.text_input(
            "쿠폰번호 입력", key="받기_쿠폰번호"
        ).strip()

        if my.st.button("상품 받기"):

            try:
                # 쿠폰 사용 처리
                my.마우스.execute("""
                    UPDATE coupons
                    SET used = 1
                    WHERE coupon_number = ?
                    AND receiver_id = ?
                    AND used = 0
                """, (coupon_number, sender_id))

                if my.마우스.rowcount == 1:

                    # 쿠폰에 해당하는 상품 조회
                    my.마우스.execute("""
                        SELECT product_name, card_message
                        FROM coupons
                        WHERE coupon_number = ?
                        AND receiver_id = ?
                    """, (coupon_number, sender_id))

                    result = my.마우스.fetchone()

                    my.conn.commit()

                    my.st.success("상품 받기 성공!")
                    my.st.write("상품 이름 :", result[0])
                    my.st.write("카드 메시지 :", result[1])

                else:
                    my.conn.rollback()
                    my.st.error(
                        "잘못된 쿠폰번호이거나 이미 사용한 쿠폰입니다."
                    )

            except Exception as e:
                my.conn.rollback()
                my.st.error(str(e))